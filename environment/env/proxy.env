# Read by buem-reverse-proxy's Caddyfile to gate POST /buem/start behind the X-Api-Key header. Callers (e.g. EnerPlanET's backend) must send this same value.
#
# IMPORTANT: Rotate before any real deployment — this is a placeholder.
BUEM_API_KEY=dev-placeholder-change-me

# Site address Caddy serves. Keep `localhost` for local development; set the
# deployment's real domain in production, or Caddy will neither serve it nor
# provision a certificate for it.
BUEM_SITE_ADDRESS=localhost
