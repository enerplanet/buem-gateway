# Common environment variables for the BuEM gateway's HTTPS environment.
BUEM_SITE_ADDRESS=your-domain.example

# Host path to Caddy's local certificate authority, so the containerised Caddy reuses an authority the host already trusts. Run `caddy trust` on the host first, which needs Caddy installed locally, then point this at what that created: Linux: ~/.local/share/caddy, macOS: ~/Library/Application Support/Caddy.
CADDY_DATA_DIR=/home/YOUR_USERNAME/.local/share/caddy

# The host port the reverse proxy publishes. Defaults to 8443 to avoid collisions with other services.
HOST_HTTPS_PORT=8443

# The port the BuEM gateway listens on inside its container. Container network isolation means this never collides across services, so it can stay the same everywhere. Single source of truth for the app, its health check and the proxy's upstream.
APP_PORT=8080