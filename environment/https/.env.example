# Read by the `docker compose` CLI for ${VARIABLE} substitution in the compose
# files here. Not injected into any container: that is ../env/common.env's job.
#
# docker-compose.yml needs none of this; it runs as it stands. Copy this file
# to `.env` for docker-compose.prod.yml, which requires the two values marked
# below.
#
#   cp .env.example .env

# Required by docker-compose.prod.yml. The domain Caddy serves and provisions a
# certificate for. Leaving it as localhost gives a deployment a certificate for
# localhost and nothing served at its own domain, so prod fails fast instead of
# defaulting.
BUEM_SITE_ADDRESS=your-domain.example

# Required by docker-compose.prod.yml. Host path to Caddy's local certificate
# authority, so the containerised Caddy reuses an authority the host already
# trusts. Run `caddy trust` on the host first, which needs Caddy installed
# locally, then point this at what that created:
#   Linux:   ~/.local/share/caddy
#   macOS:   ~/Library/Application Support/Caddy
CADDY_DATA_DIR=/home/YOUR_USERNAME/.local/share/caddy

# The host port the reverse proxy publishes. docker-compose.yml defaults to
# 8443 so it does not collide with ignis's reverse proxy on the same host.
# docker-compose.prod.yml defaults to 443, which Caddy's default ACME challenge
# validates against; only one service on a host can hold it.
HOST_HTTPS_PORT=8443

# The port buem-gateway listens on inside its container. Container network
# isolation means this never collides across services, so it can stay the same
# everywhere. Single source of truth for the app, its health check and the
# proxy's upstream.
APP_PORT=8080

# Pin the published images to a release instead of tracking `latest`. Applies
# to both buem-gateway and buem-model.
# BUEM_IMAGE_TAG=6.2.0

# No weather variables. buem-model needs no weather archive or service:
# per-request weather is supplied inline, and BUEM_WEATHER_FALLBACK=false in
# the compose files skips its module-load default fetch.
