# This proxy terminates TLS and does nothing else. It performs no
# authentication: callers are authenticated by the EnerPlanET platform before
# they reach this stack, which sits on a network the operator controls, so the
# network is the trust boundary.
#
# Site address defaults to localhost for local use. A deployment must set
# BUEM_SITE_ADDRESS to its own domain, otherwise Caddy will neither serve it
# nor provision a certificate for it. See docker-compose.prod.yml.

# HTTP/3 is disabled: the compose files publish the HTTPS port as TCP only, so
# an advertised Alt-Svc: h3 leads clients to retry over QUIC and get no
# response. Only h2 over the published TCP port is reachable.
{
	servers {
		protocols h1 h2
	}
}

{$BUEM_SITE_ADDRESS:localhost} {
	# ALLOWED_ORIGINS_PATTERN is derived from ALLOWED_ORIGINS (../env/common.env,
	# the single source of truth) at container start by the entrypoint in the
	# compose file. No origin is hardcoded here.
	@allowed_origin header_regexp Origin {$ALLOWED_ORIGINS_PATTERN}

	@preflight method OPTIONS

	# `route` preserves the order below. Without it Caddy sorts handle blocks by
	# path-matcher specificity, which would move a path-matched block ahead of
	# the preflight block and change which one answers an OPTIONS request.
	route {
		# Answered here rather than forwarded. buem-gateway's own CORS
		# middleware answers preflight identically if a request does reach it,
		# and sets the headers on real responses, which this file does not.
		handle @preflight {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			header Access-Control-Allow-Methods "GET, POST, OPTIONS"
			header Access-Control-Allow-Headers "Content-Type"
			header Access-Control-Max-Age "86400"
			respond 204
		}

		# Everything else, /buem/health included, goes straight through. That
		# endpoint is reachable on any deployment, so its response must stay
		# liveness only: no version, configuration or database detail. It is
		# nested under /buem/ rather than /health to avoid colliding with
		# sibling services behind the shared Orchestrator.
		handle {
			reverse_proxy buem-gateway:{$APP_PORT:8080}
		}
	}
}
