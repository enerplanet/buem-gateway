# Optional. Both compose files in this directory run with no .env at all:
# every value below has a working default. Copy this file to `.env` in this
# directory only if you need to change one.
#
#   cp .env.example .env

# Host interface the gateway's port is published on. Loopback by default, so
# the service is reachable from this machine and nowhere else. Nothing in this
# environment checks who is calling, so widen this only where something
# upstream does: set 0.0.0.0 for a deployment behind a firewall and the
# platform's own reverse proxy.
HOST_BIND=127.0.0.1

# Host port the gateway is published on. Pick another if 8080 is taken; the
# container side is unaffected.
HOST_PORT=8080

# The port buem-gateway listens on inside its container. Container network
# isolation means this never collides across services, so it can stay the same
# everywhere. Single source of truth for the app, its health check and the
# published port above.
APP_PORT=8080

# Pin the published images to a release instead of tracking `latest`. Applies
# to both buem-gateway and buem-model.
# BUEM_IMAGE_TAG=6.2.0

# No weather variables. buem-model needs no weather archive or service:
# per-request weather is supplied inline, and BUEM_WEATHER_FALLBACK=false in
# the compose files skips its module-load default fetch.
