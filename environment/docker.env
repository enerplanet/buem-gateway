# Injected into buem-service, buem-app, and buem-reverse-proxy via env_file.
# Dev-only defaults — replace both values below before any real deployment;
# this file is intentionally tracked (like ignis's docker.env) so a fresh
# clone runs out of the box, the same way ignis's does.

# CORS — origins allowed to call this API from a browser. Comma-separated,
# no trailing slash. buem-reverse-proxy derives a regex from this at startup
# for its preflight matcher (see docker-compose.yml + Caddyfile).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Read by buem-reverse-proxy's Caddyfile to gate POST /buem/start behind the
# X-Api-Key header. Callers (e.g. EnerPlanET's backend) must send this same
# value. Rotate before any real deployment — this is a placeholder.
BUEM_API_KEY=dev-placeholder-change-me
