# Caddyfile for the BuEM reverse proxy.
#
# Runs only under the compose `https` profile. It terminates TLS and forwards
# requests to the gateway (`api`).
# The site address defaults to localhost for local use. A deployment must set
# BUEM_SITE_ADDRESS to its own domain, otherwise Caddy will neither serve it
# nor provision a certificate for it.
{
	servers {
		protocols h1 h2
	}
}

{$BUEM_SITE_ADDRESS:localhost} {
	reverse_proxy api:{$APP_PORT:8080}
}
