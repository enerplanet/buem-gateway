# Site address defaults to localhost for local development. A deployment must
# set BUEM_SITE_ADDRESS in env/proxy.env to its own domain, otherwise Caddy
# will not serve it or provision a certificate for it.

# HTTP/3 is disabled: the compose file publishes the HTTPS port as TCP only,
# so an advertised Alt-Svc: h3 leads clients to retry over QUIC and get no
# response. Only h2 over the published TCP port is reachable.
{
	servers {
		protocols h1 h2
	}
}

{$BUEM_SITE_ADDRESS:localhost} {
	# ALLOWED_ORIGINS_PATTERN is derived from ALLOWED_ORIGINS (env/common.env,
	# the single source of truth) at container start by the entrypoint in
	# docker-compose.yml. No origin is hardcoded here.
	@allowed_origin header_regexp Origin {$ALLOWED_ORIGINS_PATTERN}

	@preflight method OPTIONS

	# Key is read from BUEM_API_KEY at container start. Real values belong in
	# env/proxy.env, untracked in production. See .env.example.
	@authorized header X-Api-Key {$BUEM_API_KEY}

	# `route` preserves the order below. Without it Caddy sorts handle blocks
	# by path-matcher specificity, which moves /buem/health ahead of the
	# preflight block and changes which one answers OPTIONS /buem/health.
	route {
		# Preflight is answered here, never forwarded. X-Api-Key is a
		# proxy-only concept; buem-gateway does not know it exists.
		handle @preflight {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			header Access-Control-Allow-Methods "GET, POST, OPTIONS"
			header Access-Control-Allow-Headers "Content-Type, X-Api-Key"
			header Access-Control-Max-Age "86400"
			respond 204
		}

		# Outside the authorised route so health checks, orchestrators and
		# uptime monitors do not need the API key. Publicly reachable on any
		# deployment, so the response must stay liveness only: no version,
		# config or database detail. Nested under /buem/ rather than /health
		# to avoid collision with sibling services behind the shared
		# Orchestrator.
		handle /buem/health {
			reverse_proxy buem-gateway:{$APP_PORT:8080}
		}

		# No CORS header set here: buem-gateway adds Access-Control-Allow-Origin
		# itself on proxied responses.
		handle @authorized {
			reverse_proxy buem-gateway:{$APP_PORT:8080}
		}

		# CORS header is set on the rejection, which the app never sees.
		# Without it a bad API key surfaces in the browser as an opaque CORS
		# error rather than this 403.
		handle {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			respond "Forbidden: missing or invalid API key" 403
		}
	}
}