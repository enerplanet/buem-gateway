# Read by the `docker compose` CLI for ${VARIABLE} substitution inside
# docker-compose.yml. NOT injected into any container — that's docker.env's job.
#
# Copy to `.env` in this directory and adjust for your machine:
#   cp .env.example .env

# Host path to Caddy's local CA storage, so the containerized Caddy reuses
# the same locally-trusted CA instead of generating a new (untrusted) one.
# Run `caddy trust` on the host first (requires Caddy installed locally), then
# point this at wherever that created the CA — typically:
#   Linux:   ~/.local/share/caddy
#   macOS:   ~/Library/Application Support/Caddy
CADDY_DATA_DIR=/home/YOUR_USERNAME/.local/share/caddy

# The host port the reverse proxy publishes. Defaults to 8443 (not 443) so
# this doesn't collide with ignis's reverse proxy if both stacks run on the
# same host — ignis's own .env.example flags this as the one port that can
# collide when several services in this namespace run side by side.
HOST_HTTPS_PORT=8443

# The internal port buem-app listens on inside its own container. Container
# network-namespace isolation means this never collides across services, so
# it can stay the same everywhere — single source of truth referenced by the
# app, its health check, and the reverse proxy's upstream.
APP_PORT=8080

# No weather variables here. buem-model needs no weather archive or service:
# per-request weather is supplied inline, and BUEM_WEATHER_FALLBACK=false
# (set in docker-compose.yml) skips its module-load default fetch.
