# Read by the `docker compose` CLI for ${VARIABLE} substitution in
# docker-compose.yml, never injected into a container (that is env/'s job).
# Every variable has a default, so `.env` is optional:
#
#   cp .env.example .env

# Set to `https` to start Caddy in front of the gateway on every `up`.
# COMPOSE_PROFILES=https

# Releases that `--no-build` runs. Published tags carry no `v` prefix.
# BUEM_GATEWAY_IMAGE_TAG=7.5.0
# BUEM_MODEL_IMAGE_TAG=6.10.0

# Host interface and port the gateway is published on. Loopback by default, so
# it is reachable from this machine only. Not 8080: the EnerPlanET platform's
# Keycloak holds that; ignis takes 8088.
HOST_BIND=127.0.0.1
HOST_PORT=8081

# Port the gateway listens on inside its container, read by the gateway, its
# health check and the Caddy upstream.
APP_PORT=8080

# https profile only. Host port Caddy publishes; 8443 so it does not collide
# with ignis's proxy on 443.
HOST_HTTPS_PORT=8443

# https profile only. Domain Caddy serves and provisions a certificate for.
# BUEM_SITE_ADDRESS=your-domain.example

# https profile only. The host directory `caddy trust` created, so Caddy reuses
# a CA the host already trusts. Unset, Caddy generates its own CA in a Docker
# volume and clients see a certificate warning.
#   Linux:   ~/.local/share/caddy
#   macOS:   ~/Library/Application Support/Caddy
# CADDY_DATA_DIR=/home/YOUR_USERNAME/.local/share/caddy
