---
config:
  layout: elk
---
flowchart TD
    subgraph VOL["sim_shared_data  (mounted at /webservice/data)"]
        direction TB

        subgraph EXISTING["Existing — renewable supply profiles (flat root)"]
            PV["pv_{lat}_{lon}.csv\ncol: capacity_factor"]
            WIND["wind_{lat}_{lon}.csv\ncol: capacity_factor"]
            BIO["biomass_{lat}_{lon}.csv\ncol: capacity_factor"]
            GEO["geothermal_{lat}_{lon}.csv\ncol: capacity_factor"]
        end

        subgraph NEW["New — building demand profiles (results/)"]
            HT["heating_{lat}_{lon}_{year}.csv\ncol: demand"]
            CL["cooling_{lat}_{lon}_{year}.csv\ncol: demand"]
        end
    end

    GW["Go Gateway\n(buem.go)"] -->|"writes"| HT
    GW -->|"writes"| CL
    CAL["Calliope"] -->|"reads"| HT
    CAL -->|"reads"| CL
    PYPSA["PyPSA"] -->|"reads"| HT
    PYPSA -->|"reads"| CL

    classDef gateway  fill:#2f5d8a,stroke:#1f2933,color:#ffffff
    classDef consumer fill:#6b7280,stroke:#1f2933,color:#ffffff
    classDef existing fill:#f5f6f7,stroke:#6b7280,color:#1f2933
    classDef newfile  fill:#b0bacf,stroke:#2f5d8a,color:#1f2933

    class GW gateway
    class CAL,PYPSA consumer
    class PV,WIND,BIO,GEO existing
    class HT,CL newfile

    style VOL      fill:#f5f6f7,stroke:#1f2933
    style EXISTING fill:#f5f6f7,stroke:#6b7280
    style NEW      fill:#eaeff5,stroke:#2f5d8a