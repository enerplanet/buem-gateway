---
config:
  layout: elk
---
flowchart TD
    subgraph VOL["sim_shared_data  (mounted at /webservice/data)"]
        direction TB

        subgraph EXISTING["Existing — renewable supply profiles (flat root)"]
            PV["pv_{lat}_{lon}.csv<br>col: capacity_factor"]
            WIND["wind_{lat}_{lon}.csv<br>col: capacity_factor"]
            BIO["biomass_{lat}_{lon}.csv<br>col: capacity_factor"]
            GEO["geothermal_{lat}_{lon}.csv<br>col: capacity_factor"]
        end

        subgraph NEW["New — building demand profiles ({BUEM_DATA_DIR}/{model_id}/)"]
            HT["heating_{lat}_{lon}_{year}.csv<br>col: demand"]
            CL["cooling_{lat}_{lon}_{year}.csv<br>col: demand"]
            EL["electricity_{lat}_{lon}_{year}.csv<br>col: demand"]
        end
    end

    GW["Go Gateway<br>(buem.go)"] -->|"writes"| HT
    GW -->|"writes"| CL
    GW -->|"writes"| EL
    CAL["Calliope"] -->|"reads heating + electricity"| HT
    CAL -->|"reads"| EL
    PYPSA["PyPSA"] -->|"reads heating + electricity"| HT
    PYPSA -->|"reads"| EL

    classDef gateway  fill:#2f5d8a,stroke:#1f2933,color:#ffffff
    classDef consumer fill:#6b7280,stroke:#1f2933,color:#ffffff
    classDef existing fill:#f5f6f7,stroke:#6b7280,color:#1f2933
    classDef newfile  fill:#b0bacf,stroke:#2f5d8a,color:#1f2933

    class GW gateway
    class CAL,PYPSA consumer
    class PV,WIND,BIO,GEO existing
    class HT,CL,EL newfile

    style VOL      fill:#f5f6f7,stroke:#1f2933
    style EXISTING fill:#f5f6f7,stroke:#6b7280
    style NEW      fill:#eaeff5,stroke:#2f5d8a
