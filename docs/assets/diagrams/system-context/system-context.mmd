---
config:
  layout: dagre
---
graph TD
    USER["Researcher / Planner\n(EnerPlanET frontend)"]

    subgraph EP["EnerPlanET Platform"]
        BE["Backend  (Go · Gin)"]

        subgraph WS["Simulation Webservice  (Go · port 8081)"]
            direction LR
            GW_B["BUEM Gateway\n/buem/start\n↕ GeoJSON FeatureCollection"]
            GW_C["Calliope Gateway\n/calliope/start\n↕ locations.yaml"]
            GW_P["PyPSA Gateway\n/pypsa/start\n↕ network YAML"]
        end
    end

    subgraph MSVC["Model Microservices"]
        BUEM["BUEM\n(Python · Flask · :5000)"]
        CAL["Calliope\n(Python CLI)"]
        PYPSA["PyPSA\n(Python CLI)"]
    end

    VOL[("sim_shared_data\nDocker volume")]

    USER    -->|"POST /api/simulate"| BE
    BE      -->|"canonical config.json\n(one shared model — all service namespaces)"| WS
    GW_B   <-->|"POST /api/process\n(buem namespace)"| BUEM
    GW_B    -->|"heating / cooling CSVs"| VOL
    GW_C    -->|"run CLI"| CAL
    CAL     -->|"reads demand CSVs"| VOL
    GW_P    -->|"run CLI"| PYPSA
    PYPSA   -->|"reads demand CSVs"| VOL
    WS      -->|"enriched config.json\n(results merged back per namespace)"| BE
    BE      -->|"simulation results"| USER

    classDef gateway     fill:#2f5d8a,stroke:#1f2933,color:#ffffff
    classDef microservice fill:#6b7280,stroke:#1f2933,color:#ffffff
    classDef platform    fill:#1f2933,stroke:#1f2933,color:#ffffff
    classDef storage     fill:#b0bacf,stroke:#2f5d8a,color:#1f2933

    class GW_B,GW_C,GW_P gateway
    class BUEM,CAL,PYPSA microservice
    class BE,USER platform
    class VOL storage

    style EP   fill:#f5f6f7,stroke:#1f2933
    style WS   fill:#eaeff5,stroke:#2f5d8a
    style MSVC fill:#f5f6f7,stroke:#6b7280