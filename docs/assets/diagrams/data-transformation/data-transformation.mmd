---
config:
  layout: dagre
---
flowchart TD
    START(["EnerPlanET backend\nPOST /buem/start\nconfig.json"]):::start

    T1["① nodeToTask()\n─────────────────\nFor each BasePOI node\nwhere properties.buem ≠ null\n─────────────────\nTopology node → GeoJSON Feature\nCoordinates lifted to geometry\nstart_time / end_time injected"]

    T2["② POST /api/process\n─────────────────\nGeoJSON Feature\n→ buem-service:5000\n?include_timeseries=true\n─────────────────\n5R1C thermal solver runs\n8 760-step simulation"]

    T3["③ extractWriteAndAnnotate()\n─────────────────\nTimeseries arrays → CSV files\nArrays stripped from response\nCSV file paths injected"]

    VOL[("sim_shared_data\nDocker volume\nheating_{lat}_{lon}_{year}.csv\ncooling_{lat}_{lon}_{year}.csv")]

    T4["④ mergeIntoTopology()\n─────────────────\nEnriched buem block\nreplaces original node's\nproperties.buem in config.json"]

    END_(["Enriched config.json\nreturned to EnerPlanET backend"]):::stop

    START  --> T1
    T1     -->|"GeoJSON Feature"| T2
    T2     -->|"GeoJSON Feature + timeseries"| T3
    T3     -->|"writes"| VOL
    T3     -->|"annotated node"| T4
    T4     --> END_

    classDef start fill:#0f766e,stroke:#134e4a,color:#ffffff,font-weight:bold
    classDef stop  fill:#1f2933,stroke:#0f172a,color:#ffffff,font-weight:bold

    style T1  fill:#eaeff5,stroke:#2f5d8a,color:#1f2933
    style T2  fill:#eaeff5,stroke:#2f5d8a,color:#1f2933
    style T3  fill:#eaeff5,stroke:#2f5d8a,color:#1f2933
    style T4  fill:#eaeff5,stroke:#2f5d8a,color:#1f2933
    style VOL fill:#b0bacf,stroke:#2f5d8a,color:#1f2933
