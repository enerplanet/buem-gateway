---
config:
  layout: dagre
---
flowchart TD
    subgraph CANON["Canonical EnerPlanET Model  (config.json)"]
        direction LR
        F["Feature\n─────────────────\ngeometry: Point [lon, lat]\nproperties.area\nproperties.feature_type\n─────────────────\nbuem: { building, solver }       ← BUEM namespace\ncalliope: { techs, demand }      ← Calliope namespace\npypsa: { … }                     ← PyPSA namespace"]
    end

    subgraph WS["Simulation Webservice  (Go · port 8081)"]
        direction TB

        subgraph IFACE["Simulation interface  (simulations/simulation.go)"]
            direction LR
            M["Path()   Configure()   Generate()\nStart()   Show()   Log()   Finish()"]
        end

        subgraph GATEWAYS["Gateway implementations"]
            direction LR
            GW_B["BUEM\nbuem.go\nmodels/buem/"]
            GW_C["Calliope\ncalliope.go\nmodels/calliope/"]
            GW_P["PyPSA\npypsa.go\nmodels/pypsa/"]
            GW_CH["Charging\ncharging.go\nmodels/charging/"]
        end

        IFACE --> GATEWAYS
    end

    subgraph SVC["Model Microservices"]
        direction LR
        B["BUEM Flask  :5000\nPOST /api/process\nGeoJSON FeatureCollection"]
        C["Calliope CLI\nbash calliope.sh\nlocations.yaml"]
        P["PyPSA CLI\nbash pypsa.sh\nnetwork YAML"]
        CH["Charging service"]
    end

    ROUTES["routes.go\nregisters each gateway\nunder /{service}/* paths"]

    CANON -->|"reads buem namespace"| GW_B
    CANON -->|"reads calliope namespace"| GW_C
    CANON -->|"reads pypsa namespace"| GW_P
    CANON -->|"reads charging namespace"| GW_CH

    ROUTES --> GATEWAYS

    GW_B  <-->|"converts to/from\nGeoJSON FeatureCollection"| B
    GW_C  <-->|"converts to/from\nlocations.yaml"| C
    GW_P  <-->|"converts to/from\nnetwork YAML"| P
    GW_CH <-->|"converts to/from\ncharging format"| CH

    GW_B  -->|"writes results back\nto buem namespace"| CANON
    GW_C  -->|"writes results back\nto calliope namespace"| CANON
    GW_P  -->|"writes results back\nto pypsa namespace"| CANON
    GW_CH -->|"writes results back\nto charging namespace"| CANON

    classDef gateway fill:#2f5d8a,stroke:#1f2933,color:#ffffff
    classDef service fill:#6b7280,stroke:#1f2933,color:#ffffff
    classDef meta    fill:#1f2933,stroke:#1f2933,color:#ffffff
    classDef imethod fill:#b0bacf,stroke:#2f5d8a,color:#1f2933
    classDef feature fill:#f5f6f7,stroke:#b0bacf,color:#1f2933

    class GW_B,GW_C,GW_P,GW_CH gateway
    class B,C,P,CH service
    class ROUTES meta
    class M imethod
    class F feature

    style CANON    fill:#f5f6f7,stroke:#b0bacf
    style WS       fill:#eaeff5,stroke:#2f5d8a
    style IFACE    fill:#b0bacf,stroke:#2f5d8a
    style GATEWAYS fill:#eaeff5,stroke:#2f5d8a
    style SVC      fill:#f5f6f7,stroke:#6b7280
